# Dashboard → backend wiring.
# Default (no file): http://localhost:4000  (Node api-server)
# Cloudflare worker local:  http://localhost:8787  (wrangler dev in apps/api-worker)
# Cloudflare worker prod:    https://<your-worker>.workers.dev
# Copy to .env.local and set the one you run.
NEXT_PUBLIC_API_URL=http://localhost:8787
