# Copy to .env
#
# --- Local Postgres (default dev) ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careconnect"
#
# --- Supabase cloud (recommended) ---
# 1. Create a project at https://supabase.com/dashboard
# 2. Open the SQL Editor and run packages/db/migrations/001_init.sql
# 3. Project Settings → Database → Connection string (pooler, port 6543) → paste below
# 4. Set USE_MOCK_DB=false and restart the api-server
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Optional Supabase API keys (for future supabase-js features; REST/auth)
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=
# Force TLS on/off regardless of host (auto-detects *.supabase.co)
# PGSSL=true

PORT=4000
LLM_API_KEY=
OLLAMA_URL=http://localhost:11434
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
USE_MOCK_DB=true
ENABLE_CRON=true
